#!/bin/sh

__perms_enable_3d="false"
__devices_enable_shm="true"
__fonts_path="/compat/linux/system-fonts"

. "${X11APPJAIL_WORKDIR}/appjail.d/init.subr"
. "${X11APPJAIL_WORKDIR}/appjail.d/network.subr"
. "${X11APPJAIL_WORKDIR}/appjail.d/devices.subr"
. "${X11APPJAIL_WORKDIR}/appjail.d/ephemeral.subr"
. "${X11APPJAIL_WORKDIR}/appjail.d/labels.subr"
. "${X11APPJAIL_WORKDIR}/appjail.d/fonts.subr"

if x11appjail sys-attr check widevine.accept.license; then
    CHROME_VERSION="156.0.8078.47-1"
    LINUX_ARCH="amd64"
    DISTFILE="google-chrome-stable_${CHROME_VERSION}_amd64.deb"
    ROOTDIR="/var/cache/x11appjail/widevine"
    DATADIR="${ROOTDIR}/d"
    TEMPDIR="${ROOTDIR}/t"

    if [ ! -f "${ROOTDIR}/.${DISTFILE}.done" ]; then
        if [ ! -d "${ROOTDIR}" ]; then
            install -d -m 755 "${ROOTDIR}"
        fi

        (
            lockf 9

            fetch -Rpm -o "${ROOTDIR}/${DISTFILE}" \
                "https://dl.google.com/linux/deb/pool/main/g/google-chrome-stable/${DISTFILE}"

            if [ -d "${TEMPDIR}" ]; then
                rm -rf "${TEMPDIR}"
            fi

            install -d -m 755 "${TEMPDIR}"

            tar -C "${TEMPDIR}" -xf "${ROOTDIR}/${DISTFILE}"

            if [ ! -d "${DATADIR}" ]; then
                install -d -m 755 "${DATADIR}"
            fi

            tar -C "${DATADIR}" -xf "${TEMPDIR}/data.tar.xz" ./opt/google/chrome/WidevineCdm

            rm -rf "${TEMPDIR}"

            rm -f "${DATADIR}/opt/google/chrome/WidevineCdm/LICENSE"

            touch "${ROOTDIR}/.${DISTFILE}.done"
        ) 9> "${ROOTDIR}/lock"
        exec 9>&-
    fi

    set -- "$@" -o fstab="\"${DATADIR}\" /widevine nullfs ro"
fi

. "${X11APPJAIL_WORKDIR}/appjail.d/dbus-dirs.subr"
. "${X11APPJAIL_WORKDIR}/appjail.d/datadir.subr"
. "${X11APPJAIL_WORKDIR}/appjail.d/end.subr"
. "${X11APPJAIL_WORKDIR}/appjail.d/oci.subr"
. "${X11APPJAIL_WORKDIR}/appjail.d/create.subr"
